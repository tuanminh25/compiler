    @Override
    public Object visitGlobalVarDecl(GlobalVarDecl ast, Object o) {
        declareVariable(ast.I, ast);
        if (ast.T.isVoidType()) {
            reporter.reportError(ErrorMessage.IDENTIFIER_DECLARED_VOID.getMessage(), "global variable can not be void", ast.position);
        } else if (ast.T.isArrayType() && ((ArrayType) ast.T).T.isVoidType()) {
            reporter.reportError(ErrorMessage.IDENTIFIER_DECLARED_VOID_ARRAY.getMessage(),
                                "global variable can not be void array", ast.I.position);
        }
        ast.E.visit(this, o);
        return null;
    }

    @Override
    public Object visitLocalVarDecl(LocalVarDecl ast, Object o) {
        declareVariable(ast.I, ast);

        if (ast.T.isVoidType()) {
            // Check illegal void type
            reporter.reportError(ErrorMessage.IDENTIFIER_DECLARED_VOID.getMessage(), "local variable can not be void", ast.position);
            // basically a local var decl - does it return type? 
            // it seems to be a no to me 
        } else if (ast.T.isArrayType() && ((ArrayType) ast.T).T.isVoidType()) {
            // Check illegal void array type
            reporter.reportError(ErrorMessage.IDENTIFIER_DECLARED_VOID_ARRAY.getMessage(),
                                "local variable can not be void array", ast.I.position);
        }

        // visit each of the below 
        // visit type -- does not matter much
        // visit ident -- have been taken care by declareVariable
        // visit expr
        ast.E.visit(this, o);

        // scope matters here - but on what level? because local var is inside func scope
        // right now assume that function should be the one who incharge of scope 
        // which means this part does not need to worry about open/ close scope
        // Just need to register stuff to table
        return null;
    }

