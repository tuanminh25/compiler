    @Override
    public Object visitCompoundStmt(CompoundStmt ast, Object o) {
        // todo: test
        idTable.openScope();

        // Paralist passed in from the function 
        // This is stored at object o! not inside ast! 
        if (o instanceof FuncDecl fd) {
            fd.PL.visit(this, o);
        }

        // Then the local var decl list 
        ast.DL.visit(this, o); // passing in function ast for extra context

        // Then the stmt list
        ast.SL.visit(this, o); // passing in function ast for extra context


        idTable.closeScope();
        return null;
    }

