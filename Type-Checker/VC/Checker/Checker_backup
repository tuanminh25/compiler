    // Expressions
    @Override
    public  Object visitAssignExpr(AssignExpr ast, Object o) {
        Type type1 = (Type) ast.E1.visit(this, o);
        Type type2 = (Type) ast.E2.visit(this, o);

        // Pass through error
        if (type1.isErrorType() || type2.isErrorType()) {
            ast.type = StdEnvironment.errorType;
        }
        // LHS type check
        else if (!(ast.E1 instanceof VarExpr || ast.E1 instanceof ArrayExpr)) {
            ast.type = StdEnvironment.errorType;
            reporter.reportError(ErrorMessage.INVALID_LVALUE_IN_ASSIGNMENT.getMessage(), "LHS of assignment must be array or var", ast.position);
        } 
        // Coercion
        else if (type1.isFloatType() && type2.isIntType()) {
            ast.E2 = new UnaryExpr(new Operator("i2f", ast.E2.position), ast.E2, ast.E2.position);
            ast.type = StdEnvironment.floatType;
        }
        // Legit case
        else if (type1.equals(type2)) {
            ast.type = type1;
        } 
        // Any other problem
        else {
            ast.type = StdEnvironment.errorType;
            reporter.reportError(
                ErrorMessage.INCOMPATIBLE_TYPE_FOR_ASSIGNMENT.getMessage(),
                "Type mismatches in assignment: " + type1 + " assigned to " + type2,
                ast.position
            );
        }
        return ast.type;
    }

    @Override
    public Object visitCallExpr(CallExpr ast, Object o) {
        // todo: test

        // 1. Link the ident and retrieve the declaration
        Decl decl = (Decl) ast.I.visit(this, o);

        // 2. Undeclared identifier
        if (decl == null) {
            reporter.reportError(ErrorMessage.IDENTIFIER_UNDECLARED.getMessage(),
                                ast.I.spelling, ast.I.position);
            ast.type = StdEnvironment.errorType;
            return ast.type;
        }

        // 3. Identifier exists but is not a function (scalar or array used as function)
        if (!(decl instanceof FuncDecl)) {
            reporter.reportError(ErrorMessage.SCALAR_ARRAY_AS_FUNCTION.getMessage(),
                                ast.I.spelling, ast.I.position);
            ast.type = StdEnvironment.errorType;
            return ast.type;
        }

        FuncDecl fd = (FuncDecl) decl;
        ast.type = fd.T;   // return type of the called function

        // 4. Walk formals (fd.PL) and actuals (ast.AL) in lockstep
        ASTList<Decl> formals = fd.PL;
        ASTList<Arg>  actuals = ast.AL;

        while (!formals.isEmpty() && !actuals.isEmpty()) {
            ParaDecl formal = (ParaDecl) formals.getHead();
            Arg      actual = actuals.getHead();

            Type actualType = (Type) actual.E.visit(this, o);
            Type formalType = formal.T;

            if (!actualType.isErrorType()) {
                if (formalType.isFloatType() && actualType.isIntType()) {
                    // int → float coercion
                    actual.E = new UnaryExpr(
                        new Operator("i2f", actual.E.position),
                        actual.E, actual.E.position);
                } else if (!formalType.equals(actualType)) {
                    // *27 – report at the position of the actual expression,
                    //        with the formal parameter name as tokenName
                    reporter.reportError(
                        ErrorMessage.WRONG_TYPE_FOR_ACTUAL_PARAMETER.getMessage(),
                        formal.I.spelling, actual.E.position);
                }
            }

            formals = formals.getNext();
            actuals = actuals.getNext();
        }

        // 5. Arity mismatch
        if (!formals.isEmpty()) {
            // actuals exhausted first → too few
            reporter.reportError(ErrorMessage.TOO_FEW_ACTUAL_PARAMETERS.getMessage(),
                                "", ast.I.position);
        } else if (!actuals.isEmpty()) {
            // formals exhausted first → too many; report at first excess actual
            reporter.reportError(ErrorMessage.TOO_MANY_ACTUAL_PARAMETERS.getMessage(),
                                "", actuals.getHead().E.position);
        }

        return ast.type;
    }
    @Override
    public  Object visitArrayExpr(ArrayExpr ast, Object o) {
        // Visit Var -> which var? i guess SimpleVar here 
        // Does it need to check explicitly about only visit ArrayType? I guess yes - because normal var is handled by VarExpr  
        // How about void array? yes this idea about void array does not exist in the whole VC program 
        // Type matters? yes it is an expression which would be evaluated 
        // Scope matters? nope, it is handled by someone else already 

        Type arrayType = (Type) ast.V.visit(this, o);
        
        // Pass through error
        if (arrayType.isErrorType()) {
            ast.type = StdEnvironment.errorType;
            return ast.type;
        }

        //  Not error type
        if (!arrayType.isArrayType()) {
            reporter.reportError(ErrorMessage.SCALAR_FUNCTION_AS_ARRAY.getMessage(),
                                "Variable was not declared as array type", ast.position);
            ast.type = StdEnvironment.errorType;
            return ast.type;
        }

        // Do we have to check for index out of bound or not ? like -1 or >= array size ? 
        // Assuming no , as run time value is checked by differnet component - not type checker
        
        // Check legit subscript number ! Which can only be int in this case
        Type subscriptType = (Type) ast.E.visit(this, o);
        if (!subscriptType.isIntType() && !subscriptType.isErrorType()) {
            reporter.reportError(ErrorMessage.ARRAY_SUBSCRIPT_NOT_INTEGER.getMessage(),
                                "", ast.position);
            ast.type = StdEnvironment.errorType;
            return ast.type;
        }

        ast.type = ((ArrayType) arrayType).T;   // .T is the element type
        return ast.type;
    }

