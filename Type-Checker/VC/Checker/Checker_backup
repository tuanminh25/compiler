    @Override
    public Object visitBinaryExpr(BinaryExpr ast, Object o) {
        // todo : test
        Type t1 = (Type) ast.E1.visit(this, o);
        Type t2 = (Type) ast.E2.visit(this, o);
        String op = ast.O.spelling;

        // divide based on operator
        if (
            op.equals("+") ||
            op.equals("-") ||
            op.equals("*") ||
            op.equals("/")
        ) {
            // if operator is arithmetic 
            if (t1.isIntType() && t2.isIntType()) {
                ast.type = t1;
            } else if (t1.isFloatType() && t2.isFloatType()) {
                ast.type = t1;
            } else if (t1.isIntType() && t2.isFloatType()) {
                ast.E1 = new UnaryExpr(new Operator("i2f", ast.O.position), ast.E1, ast.E1.position);
                ast.type = StdEnvironment.floatType;
            } else if (t1.isFloatType() && t2.isIntType()) {
                ast.E2 = new UnaryExpr(new Operator("i2f", ast.O.position), ast.E2, ast.E2.position);
                ast.type = StdEnvironment.floatType;
            }
            else {
                // definitely error
                // todo: scream
                ast.type = StdEnvironment.errorType;
                reporter.reportError(ErrorMessage.INCOMPATIBLE_TYPE_FOR_BINARY_OPERATOR.getMessage(), "Wrong expr type with arithemtic operation ", ast.O.position);
         
            }
        }

        // else if operator is boolean operation 
        else if (
            op.equals("||") ||
            op.equals("&&")
            ) {
            // boolean expr
            if (t1.isBooleanType() && t2.isBooleanType()) {
                ast.type = StdEnvironment.booleanType;
            } else {
                ast.type = StdEnvironment.errorType;
                reporter.reportError(ErrorMessage.INCOMPATIBLE_TYPE_FOR_BINARY_OPERATOR.getMessage(), "Wrong expr type with && || ", ast.O.position);
            }
        } else if (
            op.equals("<") ||
            op.equals("<=") ||
            op.equals(">") ||
            op.equals(">=") ) {
            // If compare greater / lt
            if (t1.isIntType() && t2.isIntType()) {
                ast.type = StdEnvironment.booleanType;
            } else if (t1.isFloatType() && t2.isFloatType()) {
                ast.type = StdEnvironment.booleanType;
            } else if (t1.isIntType() && t2.isFloatType()) {
                ast.E1 = new UnaryExpr(new Operator("i2f", ast.O.position), ast.E1, ast.E1.position);
                ast.type = StdEnvironment.booleanType;
            } else if (t1.isFloatType() && t2.isIntType()) {
                ast.E2 = new UnaryExpr(new Operator("i2f", ast.O.position), ast.E2, ast.E2.position);
                ast.type = StdEnvironment.booleanType;
            } else {
                ast.type = StdEnvironment.errorType;
                reporter.reportError(ErrorMessage.INCOMPATIBLE_TYPE_FOR_BINARY_OPERATOR.getMessage(), "Wrong expr type with <=>  ", ast.O.position);
            }

        } else if (
            op.equals("==") ||
            op.equals("!=") ) {
            // equality
            if (t1.isBooleanType() && t2.isBooleanType()) {
                ast.type = StdEnvironment.booleanType;
            } else if (t1.isIntType() && t2.isIntType()) {
                ast.type = StdEnvironment.booleanType;
            } else if (t1.isFloatType() && t2.isFloatType()) {
                ast.type = StdEnvironment.booleanType;
            } else if (t1.isIntType() && t2.isFloatType()) {
                ast.E1 = new UnaryExpr(new Operator("i2f", ast.O.position), ast.E1, ast.E1.position);
                ast.type = StdEnvironment.booleanType;
            } else if (t1.isFloatType() && t2.isIntType()) {
                ast.E2 = new UnaryExpr(new Operator("i2f", ast.O.position), ast.E2, ast.E2.position);
                ast.type = StdEnvironment.booleanType;
            } else {
                ast.type = StdEnvironment.errorType;
                reporter.reportError(ErrorMessage.INCOMPATIBLE_TYPE_FOR_BINARY_OPERATOR.getMessage(), "Wrong expr type with == != ", ast.O.position);
            }
        } else {
            ast.type = StdEnvironment.errorType;
            reporter.reportError(ErrorMessage.INCOMPATIBLE_TYPE_FOR_BINARY_OPERATOR.getMessage(), "Unrecognised operator", ast.O.position);
        }
        return ast.type;
    }

    /**
     * unary-expr   -> "+" unary-expr
                    |  "-" unary-expr
                    |  "!" unary-expr
                    |  primary-expr
     */
    @Override
    public Object visitUnaryExpr(UnaryExpr ast, Object o) {
        Type eType = (Type) ast.E.visit(this, o);  
        String op = ast.O.spelling;
        if (op.equals("+") || op.equals("-")) {
            // Check type int / float
            if (eType.isIntType() || eType.isFloatType() ) {
                ast.type = eType;
            } else {
                ast.type = StdEnvironment.errorType;
                reporter.reportError(ErrorMessage.INCOMPATIBLE_TYPE_FOR_UNARY_OPERATOR.getMessage(), "Expecting float/int type here", ast.O.position);
            }

        } else if (op.equals("!")) {
            // Check type bool
            if (eType.isBooleanType() ) {
                ast.type = eType;
            } else {
                ast.type = StdEnvironment.errorType;
                reporter.reportError(ErrorMessage.INCOMPATIBLE_TYPE_FOR_UNARY_OPERATOR.getMessage(), "Expecting boolean type here", ast.O.position);
            }

        } else {
            // Operator error here INCOMPATIBLE_TYPE_FOR_UNARY_OPERATOR
            reporter.reportError(ErrorMessage.INCOMPATIBLE_TYPE_FOR_UNARY_OPERATOR.getMessage(), "Unexpected operator", ast.O.position);
        }
        return ast.type;
    }

